# AIRI websocket server
# Do not change unless server runtime ws route changes
OPENCLAW_AIRI_WS_URL=ws://localhost:6121/ws
OPENCLAW_AIRI_TOKEN=

# OpenClaw endpoint (single call API)
OPENCLAW_BASE_URL=http://localhost:8001
OPENCLAW_INVOKE_PATH=/v1/airi/invoke

# 可选：OpenClaw API 鉴权
OPENCLAW_API_KEY=

# 健康检查（用于 local-runtime 状态展示）
OPENCLAW_BRIDGE_HEALTH_URL=http://localhost:8001/health
OPENCLAW_RUNTIME_HEALTH_URL=http://localhost:8001/health

# 记忆关联策略
OPENCLAW_CONTEXT_TOP_K=8

# 功能开关
OPENCLAW_ENABLE_MEMORY=true
OPENCLAW_ENABLE_AGENT=true
