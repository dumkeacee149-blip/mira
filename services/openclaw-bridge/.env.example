# MIRA websocket server
OPENCLAW_MIRA_WS_URL=ws://localhost:6121/ws
OPENCLAW_MIRA_TOKEN=

# OpenClaw endpoint (single call API)
OPENCLAW_BASE_URL=http://localhost:8000
OPENCLAW_INVOKE_PATH=/v1/mira/invoke

# 可选：OpenClaw API 鉴权
OPENCLAW_API_KEY=

# 记忆关联策略
OPENCLAW_CONTEXT_TOP_K=8

# 功能开关
OPENCLAW_ENABLE_MEMORY=true
OPENCLAW_ENABLE_AGENT=true
