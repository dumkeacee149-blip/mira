{
  "name": "@proj-mira/iconify-meteocons",
  "type": "module",
  "version": "0.1.4",
  "description": "Iconify JSON IconSet port for Meteocons",
  "author": {
    "name": "Project Mira Team",
    "email": "contact@mira.local",
    "url": "https://github.com/dumkeacee149-blip"
  },
  "license": "MIT",
  "homepage": "https://github.com/basmilius/weather-icons",
  "repository": {
    "type": "git",
    "url": "https://github.com/dumkeacee149-blip/mira.git",
    "directory": "packages/iconify-meteocons"
  },
  "exports": {
    "./*": "./*",
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.mjs"
    },
    "./icons.json": "./dist/icons.json",
    "./info.json": "./dist/info.json",
    "./metadata.json": "./dist/metadata.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "dependencies": {
    "@iconify/types": "^2.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.1",
    "@iconify/tools": "^5.0.0",
    "@types/node": "^25.0.2",
    "bumpp": "^10.3.2",
    "changelogithub": "^14.0.0",
    "eslint": "^9.39.2",
    "lint-staged": "^16.2.7",
    "local-pkg": "^1.1.2",
    "simple-git-hooks": "^2.13.1",
    "taze": "^19.9.2",
    "tsdown": "^0.17.4",
    "typescript": "^5.9.3",
    "unplugin-unused": "^0.5.6"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "scripts": {
    "dev": "tsdown",
    "stub": "tsdown",
    "build": "echo \"Prebuilt package; no build step required\"",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "typecheck": "echo \"Prebuilt package; no typecheck step required\"",
    "sizecheck": "npx vite-bundle-visualizer",
    "up": "taze -w -r -I -f && pnpm prune && pnpm dedupe",
    "changelogithub": "changelogithub"
  }
}
