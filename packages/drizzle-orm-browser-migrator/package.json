{
  "name": "@proj-mira/drizzle-orm-browser-migrator",
  "type": "module",
  "version": "0.1.6",
  "description": "🦆 Drizzle ORM migrator applies migrations in browser environment, for PGLite, SQLite, DuckDB WASM!",
  "author": {
    "name": "Project Mira Team",
    "email": "contact@mira.local",
    "url": "https://github.com/dumkeacee149-blip"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dumkeacee149-blip/mira.git",
    "directory": "packages/drizzle-orm-browser-migrator"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "node": "./dist/index.mjs"
    },
    "./pglite": {
      "types": "./dist/pglite/index.d.mts",
      "import": "./dist/pglite/index.mjs",
      "node": "./dist/pglite/index.mjs"
    },
    "./pg": {
      "types": "./dist/pg/index.d.mts",
      "import": "./dist/pg/index.mjs",
      "node": "./dist/pg/index.mjs"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.mts",
      "import": "./dist/postgres/index.mjs",
      "node": "./dist/postgres/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "peerDependencies": {
    "drizzle-orm": ">=0.44.0"
  },
  "dependencies": {
    "@guiiai/logg": "^1.1.0"
  },
  "scripts": {
    "dev": "tsdown",
    "stub": "tsdown",
    "build": "echo \"Prebuilt package; no build step required\"",
    "typecheck": "echo \"Prebuilt package; no typecheck step required\"",
    "test": "vitest",
    "test:run": "vitest run",
    "attw": "attw --pack . --profile esm-only --ignore-rules cjs-resolves-to-esm"
  }
}
