{
  "name": "@proj-mira/server-runtime",
  "type": "module",
  "version": "0.9.0-alpha.18",
  "description": "Server runtime implementation for MIRA running in different environments",
  "author": {
    "name": "Project Mira Team",
    "email": "contact@mira.local",
    "url": "https://github.com/dumkeacee149-blip"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dumkeacee149-blip/mira.git",
    "directory": "packages/server-runtime"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "default": "./dist/server.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": "./dist/bin/run.mjs",
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "scripts": {
    "dev": "tsx ./src/bin/run.js",
    "start": "tsx ./src/bin/run.js",
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@guiiai/logg": "catalog:",
    "@moeru/std": "catalog:",
    "@proj-mira/server-shared": "workspace:^",
    "crossws": "^0.4.4",
    "h3": "^2.0.1-rc.14",
    "nanoid": "catalog:",
    "srvx": "^0.11.8",
    "superjson": "catalog:"
  }
}
